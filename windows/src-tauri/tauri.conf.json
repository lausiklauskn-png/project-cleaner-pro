{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projekt-Reiniger Pro",
  "mainBinaryName": "projekt-reiniger-pro",
  "version": "14.0.0",
  "identifier": "de.familyprojekt.projektreiniger.pro",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "node tools/build-web.mjs" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Projekt-Reiniger Pro", "url": "index.html", "width": 1280, "height": 860, "minWidth": 360, "minHeight": 560, "center": true, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "family-projekt",
    "category": "Utility",
    "shortDescription": "Persönliche Daten in Projekten finden und entfernen, bevor sie an eine KI gehen",
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser", "languages": ["German", "English"] } }
  }
}
